      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "您真的要就这样走掉吗？",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "对啊，我忙得很，恕不奉陪！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "unit_animation",
            "data": {
