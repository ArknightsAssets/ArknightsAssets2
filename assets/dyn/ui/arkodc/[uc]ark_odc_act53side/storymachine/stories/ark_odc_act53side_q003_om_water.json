      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "我麦尼尔身为雷姆必拓人，不会忘了自己的本。一日矿工，终生矿工，征服天灾、找到矿脉，那就是雷姆必拓人的命中注定！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "unit_animation",
            "data": {
              "id": "npc_001_agoldm_2",
