            "type": "unit_animation",
            "data": {
              "id": "npc_001_agoldm_2",
              "animationName": "Angry",
              "pauseOnEnd": false
            }
          }
        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "可是在我看来，雷姆必拓人的精神是开拓进取才对！你们不畏惧新事物，才敢踏入这片荒野，找到一片又一片适宜居住的土地。",
            "avatarId": "arkvent_char_1015_aglna2_serious",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "这一路上，我看到太多人在荒芜的土地上、在绝境中，用自己的办法生存下来。就像麦尼尔太太，一手操办度假村里的一切事务，您却天天躲在这里不敢面对。",
            "avatarId": "arkvent_char_1015_aglna2_angry",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "我、我......",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
