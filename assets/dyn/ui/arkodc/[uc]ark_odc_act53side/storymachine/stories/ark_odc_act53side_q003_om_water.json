      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "安洁莉娜啊......来、来度假吗？放开了玩啊，我先去忙了，有事你找我老婆......",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "麦尼尔先生，请稍等。",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "......还有什么事？",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "麦尼尔先生最近很忙吧？也对哦，仅靠少少的人就要撑起整个温泉度假村的运营，招待那么多客人，一定很辛苦。",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "camera_focus_unit",
            "data": {
              "id": "avatar_aglina_2",
