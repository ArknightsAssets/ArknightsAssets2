        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "麦尼尔先生......请留步。",
            "avatarId": "arkvent_char_1015_aglna2_blank",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "......你到底想说什么？我知道了，是那老太婆派你来的！她早就忘了矿工的尊严，在这里低声下气地当服务人员。你去告诉她——",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "unit_face",
            "data": {
              "faces": [
