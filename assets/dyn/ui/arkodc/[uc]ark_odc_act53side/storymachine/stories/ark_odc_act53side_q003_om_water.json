      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "......麦尼尔先生，您这么说，我也要生气了。",
            "avatarId": "arkvent_char_1015_aglna2_serious",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "您其实是在不安吧，维护度假村，和客人打交道，这一切要运营起来都不容易，您过去几十年的经验都用不上了。您就用雷姆必拓人的追求当做逃避的借口，把脏活累活都留给麦尼尔太太。",
            "avatarId": "arkvent_char_1015_aglna2_serious",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "啊？！我——",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
