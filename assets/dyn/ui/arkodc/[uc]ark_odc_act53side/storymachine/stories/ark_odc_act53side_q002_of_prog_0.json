      {
        "depth": 1,
        "leadLine": {
          "type": "unit_emoji",
          "data": {
            "id": "avatar_aglina",
            "source": "ACTIVITY",
            "themeId": "ark_odc_act53side",
            "picId": "pic_ark_odc_surprise",
