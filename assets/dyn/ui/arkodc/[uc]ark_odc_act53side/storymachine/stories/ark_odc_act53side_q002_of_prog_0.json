      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "麦尼尔太太、先生，我就说我们会再见面的吧。就是没想到这么快，我们刚从太阳谷出来就看到你们啦。",
            "avatarId": "arkvent_char_1015_aglna2_smile",
            "options": [],
