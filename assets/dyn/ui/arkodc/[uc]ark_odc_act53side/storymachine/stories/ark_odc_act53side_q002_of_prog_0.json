            "pauseOnEnd": false
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "阿梅利亚",
            "content": "我猜麦尼尔先生只是路过这里吧。毕竟，上次他强调说，他是看不上太阳谷这帮“黄毛小子黄毛丫头”的，应该不会来找他们帮忙的。",
            "avatarId": "arkvent_char_4236_tmslot_softsmile",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "play_audio",
          "data": {
            "module": "ui",
            "signal": "ON_ACT53SIDE_EMOJI",
            "subSignal": "",
            "isMusic": false,
            "channel": ""
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "unit_emoji",
          "data": {
            "source": "ACTIVITY",
            "themeId": "ark_odc_act53side",
            "picId": "pic_ark_odc_mad",
            "delay": 0,
            "duration": 1,
            "id": "npc_001_agoldm",
            "flipX": true
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "那你就猜错了，我在下面看到，平台的钻井设备已经启动了，麦尼尔先生一定是在这里找到了合适的探矿师和矿脉吧~",
            "avatarId": "arkvent_char_4237_jcinta_relieved",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "unit_animation",
            "data": {
              "pauseOnEnd": false,
              "id": "char_4237_jcinta",
              "animationName": "Salute"
            }
          }
        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "（小声）噗......嘉辛塔，阿梅是在揶揄他哦。",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "unit_animation",
          "data": {
            "id": "char_4237_jcinta",
            "animationName": "Shock",
            "pauseOnEnd": false
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "（小声）欸，那我岂不是火上浇油？",
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "avatarId": "arkvent_char_4237_jcinta",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "哎呀，哈哈......总之，看来你们的采矿平台又能持续运作了，恭喜。",
            "avatarId": "arkvent_char_4237_jcinta_laugh",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "麦尼尔先生",
            "content": "没什么好恭喜的。现在的情况......啧，跟小孩子抱怨什么。我去忙了，那帮小孩没一个让人省心的，一秒不看着就要搞出问题！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
