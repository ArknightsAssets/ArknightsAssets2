          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "当然~这样的愉快体验从来不嫌多。安洁也是哦。这一路以来，带着我们三个有多头痛，我们都猜得到啦。",
            "avatarId": "arkvent_char_4237_jcinta",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
