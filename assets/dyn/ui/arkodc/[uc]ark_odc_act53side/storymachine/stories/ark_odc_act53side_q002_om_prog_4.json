        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "我明白这位信使小姐的意思了。人总是容易被情绪奴役，她会替我们过滤出最关键的信息。",
            "style": "LEFT_AVATAR",
            "name": "太阳谷探矿师",
            "avatarId": "arkvent_npc_2350",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "嗯！麦尼尔先生，您说呢？",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
