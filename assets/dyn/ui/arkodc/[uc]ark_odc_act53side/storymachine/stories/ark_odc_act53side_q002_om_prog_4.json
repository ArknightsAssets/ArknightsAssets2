      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "当然是完成一名信使的本职工作。接下来，二位之间的信息，将由我来传递。",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
