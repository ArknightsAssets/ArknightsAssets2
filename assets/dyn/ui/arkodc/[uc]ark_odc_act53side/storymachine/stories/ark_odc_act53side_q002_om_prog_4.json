      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "沟通明明是要把最有用的信息传达给对方，现在你们却只听得到对方对自己的冒犯。",
            "style": "LEFT_AVATAR",
