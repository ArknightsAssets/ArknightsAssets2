            }
          }
        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "嫌......嫌少吗？我说的是，二十万每人！",
            "avatarId": "arkvent_char_4237_jcinta_surprised",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "content": "哎呀我的个有袋鼷兽啊！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "还不行？讲价失败......",
            "avatarId": "arkvent_char_4237_jcinta_troubled",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "平静的老妇人",
            "content": "亨利，别太孩子气。",
            "avatarId": "arkvent_npc_2352",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "wait",
          "data": {
            "duration": 0.5
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "unit_face",
          "data": {
            "faces": [
              {
                "sign": 1,
                "id": "om"
              }
            ]
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "wait",
          "data": {
            "duration": 0.5
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "content": "不是......是她在裂兽大开口啊！我本来只打算......意思意思收两百......所有人。",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "咦！只要这点......？",
            "avatarId": "arkvent_char_4237_jcinta_troubled",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "平静的老妇人",
            "content": "两百也不应该的。你知道在这里赶夜路有多危险。",
            "avatarId": "arkvent_npc_2352",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "content": "哈？那要我堂堂矿工说话不算话吗！......那、那你们就用劳动抵扣登台费。",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "unit_face",
            "data": {
              "faces": [
                {
                  "sign": -1,
                  "id": "om"
                }
              ]
            }
          }
        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "content": "不是想找地方住吗，把后面的商业街打扫干净，自己找里面的房间住！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "真的只要打扫商业街，您就允许我们留宿？",
            "avatarId": "arkvent_char_1015_aglna2",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        },
        "subLines": [
          {
            "type": "camera_focus_unit",
            "data": {
              "id": "ang2",
              "offset": {
                "x": 0.5,
                "y": 0.5,
                "z": 0
              },
              "distance": 7,
              "duration": 0.5,
              "ease": "InOutSine"
            }
          }
        ]
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "content": "哼，你以为是什么容易的事吗。告诉你们，出门在外就没有容易的事！",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "感谢！我们这就行动起来。二位打理这么大的平台一定很辛苦，我们会连您这边的屋子一起打扫干净的。",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2_wink",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "你是说我们老了打扫起来有心无力平台上积的灰都没到脚踝了趁机欺负过路的旅客敲诈你们帮我们打扫吗？！",
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "没有这个意思，我是说......",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2_frightened",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "您的移动平台真的很好，值得用更多的劳动来支付住宿的费用呢，嗯！",
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "avatarId": "arkvent_char_1015_aglna2_shy",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
