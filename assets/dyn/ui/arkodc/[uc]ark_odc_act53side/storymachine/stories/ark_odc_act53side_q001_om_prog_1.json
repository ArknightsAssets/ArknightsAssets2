      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "阿梅利亚",
            "content": "（悄声）登台费是什么，第一次听说......",
            "avatarId": "arkvent_char_4236_tmslot",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "是一般物流车辆登上商用移动平台的费用。",
            "avatarId": "arkvent_char_4237_jcinta",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "阿梅利亚",
            "content": "连你都说贵，难道登台费是天价？我看他是看准我们不敢露宿在间歇泉区，就裂兽大开口。就算不在他的平台借宿，我们也可以睡车里啊......",
            "avatarId": "arkvent_char_4236_tmslot",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "嘉辛塔",
            "content": "（悄声）少安勿躁，我来和他讲价试试。嗯，我可以的，肯定可以的——",
            "avatarId": "arkvent_char_4237_jcinta_blank",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
