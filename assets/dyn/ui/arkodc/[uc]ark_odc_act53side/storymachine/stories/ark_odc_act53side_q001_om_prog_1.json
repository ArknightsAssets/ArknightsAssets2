      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "content": "哼......",
            "style": "LEFT_AVATAR",
            "name": "烦躁的老先生",
            "avatarId": "arkvent_npc_2351",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "那么，塔妮，嘉辛塔，阿梅，我们一起帮老人家打扫一下吧？后面的商业街交给我就行~",
            "avatarId": "arkvent_char_1015_aglna2_embarrassed",
