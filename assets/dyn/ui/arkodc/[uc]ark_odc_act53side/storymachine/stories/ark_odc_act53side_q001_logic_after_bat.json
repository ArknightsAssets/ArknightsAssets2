      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "欸，老先生怎么看上去......更生气了？",
            "avatarId": "arkvent_char_1015_aglna2_embarrassed",
