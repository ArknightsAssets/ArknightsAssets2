      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "安洁莉娜",
            "content": "唉，那两人都七倒八歪的了。嘉辛塔呢，你还好吧？",
            "avatarId": "arkvent_char_1015_aglna2",
