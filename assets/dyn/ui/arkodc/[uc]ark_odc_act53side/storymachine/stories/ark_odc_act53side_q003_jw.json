        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "贾维",
            "content": "奥斯塔，他这表情是什么意思？",
            "avatarId": "arkvent_char_349_chiave",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "奥斯塔",
            "content": "不远千里联系上据说能把心爱的矿车改造得很酷炫的叙拉古人，拿到手却觉得不过如此的意思。",
            "avatarId": "arkvent_char_346_aosta",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "贾维",
            "content": "啥？",
            "avatarId": "arkvent_char_349_chiave_angry_flustered",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "布洛卡",
            "content": "就是不满意你的改装。",
            "avatarId": "arkvent_char_356_broca",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "贾维",
            "content": "哈？！喂，小爷我特地跑那么远来给你交货，可是信心满满啊！你小子睁大眼睛看清楚我的巧妙改装！",
            "avatarId": "arkvent_char_349_chiave_shocked",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "贾维",
            "content": "把矿洞照成汐斯塔阳光沙滩的超大号照明灯、把泥巴地跑成米诺斯竞速跑道的越野轮胎，还有——",
            "avatarId": "arkvent_char_349_chiave_angry_flustered",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
      },
      {
        "depth": 1,
        "leadLine": {
          "type": "dialog",
          "data": {
            "style": "LEFT_AVATAR",
            "name": "贾维",
            "content": "你最想要的，震撼全矿场的超大声高保真音响！哪里不满意？！",
            "avatarId": "arkvent_char_349_chiave_angry_flustered",
            "options": [],
            "avatarSource": "ACTIVITY"
          }
        }
